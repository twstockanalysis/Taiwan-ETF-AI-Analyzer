# SQLite database files
database/*.db
database/*.db-shm
database/*.db-wal

# Python virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Downloaded and generated ETF data
data/raw/*
data/processed/*
data/rejected/*

# Keep data directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/rejected/.gitkeep

# Local SQLite databases and backup files
**/*.db
**/*.db.*
**/*.sqlite
**/*.sqlite3

# Deployment secrets
deployment/.env

# Environment and application secrets
.env
.env.*
!.env.example
!deployment/.env.example
.streamlit/secrets.toml
**/secrets.toml

# Private keys and credential containers
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519

# Local logs, reports, and ad-hoc backups
*.log
logs/
reports/
*.bak
*.backup
*.orig
*.tmp
backup/
backups/
legacy/
snapshots/
source_snapshots/

# Test and coverage caches
.pytest_cache/
.coverage
htmlcov/
