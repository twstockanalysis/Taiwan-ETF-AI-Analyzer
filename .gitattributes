* text=auto eol=lf

# Source code and project documentation are UTF-8 text with LF line endings.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Common binary artifacts must never be line-ending normalized.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
